  "steps": [
    {
      "caption": "Files are saved through a DataSource interface. Now some must be compressed, some encrypted, some both.",
      "diagram": "base",
      "highlight": [
        "source",
        "file"
      ],
      "predict": {
        "prompt": "With one subclass per mix, how many classes do compression and encryption need?",
        "options": [
          {
            "text": "Three: Compressed, Encrypted, and CompressedEncrypted",
            "explanation": "Right. Each new option multiplies the mixes, and the order of the steps matters too."
          },
          {
            "text": "Two",
            "explanation": "The mix of both needs its own class as well."
          },
          {
            "text": "One",
            "explanation": "One class can't be compressed-only, encrypted-only and both."
          }
        ],
        "answer": 0
      }
    },
    {
      "caption": "Decorator: Compressed implements DataSource and also holds one (inner). It does its step, then passes the call on.",
      "diagram": "base",
      "highlight": [
        "comp"
      ],
      "code": [
        "class Compressed(DataSource):",
        "    def __init__(self, inner):",
        "        self.inner = inner",
        "",
        "    def write(self, data):",
        "        self.inner.write(",
        "            zlib.compress(data))"
      ]
    },
    {
      "caption": "Wrappers stack in any order: Compressed(Encrypted(FileSource('a.txt'))). The outer one runs first…",
      "diagram": "stack",
      "call": 0
    },
    {
      "caption": "…and passes its result to the next, until it reaches the file.",
      "diagram": "stack",
      "call": 1,
      "predict": {
        "prompt": "Compressed(Encrypted(file)).write(data): what reaches the file?",
        "options": [
          {
            "text": "encrypt(compress(data))",
            "explanation": "Right. The outer wrapper (Compressed) acts first, then hands its result to Encrypted."
          },
          {
            "text": "compress(encrypt(data))",
            "explanation": "That would be Encrypted(Compressed(file)): the outer one runs first."
          },
          {
            "text": "data, unchanged",
            "explanation": "Each wrapper transforms the data before passing it on."
          }
        ],
        "answer": 0
      }
    },
    {
      "caption": "Each layer returns, outermost last. No class needed changing to add a feature.",
      "diagram": "stack",
      "call": 3
    },
    {
      "caption": "Adapter: a vendor's SMS library has send_text(phone, body), but our code expects Notifier.send(user, msg). SmsAdapter implements Notifier and translates.",
      "diagram": "adapter",
      "highlight": [
        "adapt"
      ],
      "code": [
        "class SmsAdapter(Notifier):",
        "    def send(self, user, msg):",
        "        self.lib.send_text(",
        "            user.phone, msg)"
      ],
      "predict": {
        "prompt": "The vendor renames send_text to deliver. What changes?",
        "options": [
          {
            "text": "Only SmsAdapter",
            "explanation": "Right. It's the one place that knows the vendor's names."
          },
          {
            "text": "Alerts and every other caller",
            "explanation": "They only use Notifier, which hasn't changed."
          },
          {
            "text": "The Notifier interface",
            "explanation": "Our interface is ours; the vendor's rename doesn't touch it."
          }
        ],
        "answer": 0
      }
    }
  ],
  "exercise": {
    "change": "Switch to a new SMS vendor whose method is push(number, text).",
    "flawed": "direct",
    "fixed": "adapted",
    "edits": {
      "flawed": [
        "alerts",
        "otp",
        "promos"
      ],
      "fixed": [
        "adapt"
      ]
    },
    "hint": "Which classes call the vendor's send_text() themselves?",
    "fix": {
      "prompt": "How should the design change?",
      "options": [
        {
          "text": "Hide the vendor behind a Notifier interface, with one SmsAdapter that translates calls",
          "explanation": "Right. Only the adapter knows the vendor."
        },
        {
          "text": "Rename our own methods to match the new vendor",
          "explanation": "Every caller still changes, and the next vendor repeats it."
        },
        {
          "text": "Wrap each call site in try/except",
          "explanation": "That handles errors, not a changed method name."
        }
      ],
      "answer": 0
    },
    "explain": "Alerts, Otp and Promos depend only on Notifier. Switching vendors means rewriting SmsAdapter to call push(number, text); nothing else changes."
  },
  "quiz": [
    {
      "prompt": "Why wrap a DataSource in a decorator instead of subclassing it to add logging?",
      "options": [
        {
          "text": "A wrapper works on any DataSource at run time, and wrappers combine in any order",
          "explanation": "Right. No new class per combination."
        },
        {
          "text": "Subclasses combine more easily",
          "explanation": "Each combination would need its own subclass."
        },
        {
          "text": "Decorators edit the original class",
          "explanation": "They wrap it; the original class is untouched."
        }
      ],
      "answer": 0
    },
    {
      "prompt": "What is an adapter for?",
      "options": [
        {
          "text": "Making a class with the wrong interface fit the one your code expects",
          "explanation": "Right. It translates calls, like a travel plug adapter."
        },
        {
          "text": "Adding features to an object",
          "explanation": "That's a decorator."
        },
        {
          "text": "Choosing an algorithm at run time",
          "explanation": "That's Strategy."
        }
      ],
      "answer": 0
    }
  ]
