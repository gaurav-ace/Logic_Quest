  "steps": [
    {
      "caption": "I, interface segregation: \"Keep interfaces small so that users don't end up depending on things they don't need.\" This Machine interface asks every device to print, scan and fax.",
      "diagram": "fat",
      "highlight": [
        "machine"
      ]
    },
    {
      "caption": "A basic printer must still provide scan() and fax(), which just raise errors.",
      "diagram": "fat",
      "highlight": [
        "basic"
      ],
      "predict": {
        "prompt": "The fax() method changes its arguments. Which classes must be edited?",
        "options": [
          {
            "text": "Every class that implements Machine, even printers that never fax",
            "explanation": "Right. A fat interface ties every implementer to every method."
          },
          {
            "text": "Only OfficeBox, which really faxes",
            "explanation": "BasicPrinter also has a fax() (one that raises an error), so it must change to match."
          },
          {
            "text": "None",
            "explanation": "The interface changed, so its implementers must follow."
          }
        ],
        "answer": 0
      }
    },
    {
      "caption": "Split it: Printer and Scanner are small interfaces. BasicPrinter implements only Printer; OfficeBox implements both.",
      "diagram": "split",
      "highlight": [
        "printer",
        "scanner"
      ]
    },
    {
      "caption": "D, dependency inversion: \"High level modules should not depend upon low level details.\" OrderService builds its own MySqlDb inside.",
      "diagram": "concrete",
      "highlight": [
        "service"
      ],
      "code": [
        "class OrderService:",
        "    def __init__(self):",
        "        self.db = MySqlDb()"
      ],
      "predict": {
        "prompt": "How would you unit-test OrderService without a real MySQL server?",
        "options": [
          {
            "text": "You can't easily: it builds its own MySqlDb",
            "explanation": "Right. The detail is wired in, so tests need the real database."
          },
          {
            "text": "Mock the network card",
            "explanation": "That is far harder than it should be, and fragile."
          },
          {
            "text": "Tests don't need a database",
            "explanation": "This class creates one whenever it starts, so a test can't avoid it."
          }
        ],
        "answer": 0
      }
    },
    {
      "caption": "Invert it: OrderService depends on an OrderStore interface, and the store is passed in. MySqlStore is one implementation; a FakeStore for tests is another.",
      "diagram": "inverted",
      "highlight": [
        "store"
      ],
      "code": [
        "class OrderService:",
        "    def __init__(self, store):",
        "        self.store = store",
        "",
        "OrderService(FakeStore())"
      ]
    },
    {
      "caption": "Now the arrows from the details (MySQL, the fake) point up at the abstraction. That reversal is the \"inversion\".",
      "diagram": "inverted",
      "highlight": [
        "fake",
        "mystore"
      ]
    }
  ],
  "exercise": {
    "change": "Move orders from MySQL to PostgreSQL.",
    "flawed": "direct",
    "fixed": "wired",
    "edits": {
      "flawed": [
        "orders",
        "refunds",
        "report"
      ],
      "fixed": [
        "main"
      ]
    },
    "hint": "Which classes create MySqlDb or call its MySQL-specific methods themselves?",
    "fix": {
      "prompt": "How should the design change?",
      "options": [
        {
          "text": "Define an OrderStore interface the services use, implement it with MySqlStore, and choose the store in one place (Main)",
          "explanation": "Right. The services never name a database, so switching is a new store class plus one line in Main."
        },
        {
          "text": "Wrap MySqlDb in a global that every class imports",
          "explanation": "The MySQL details still leak into every caller, and a global makes testing harder."
        },
        {
          "text": "Make the services inherit from MySqlDb",
          "explanation": "That ties them to MySQL even more tightly."
        }
      ],
      "answer": 0
    },
    "explain": "OrderService, RefundService and ReportJob only know OrderStore. Moving to PostgreSQL means writing a PgStore that implements it, and changing the one line in Main that picks the store."
  },
  "quiz": [
    {
      "prompt": "A class implements an interface but leaves three methods raising NotImplementedError. What does that hint at?",
      "options": [
        {
          "text": "Interface segregation: the interface is too big for this class",
          "explanation": "Right. Split it so each class implements only what it can really do."
        },
        {
          "text": "Single responsibility",
          "explanation": "The class may have one job; the trouble is the interface asking for more."
        },
        {
          "text": "Open/closed",
          "explanation": "Nothing here is about adding features without edits."
        }
      ],
      "answer": 0
    },
    {
      "prompt": "Why does passing a FakeStore into OrderService make testing easy?",
      "options": [
        {
          "text": "The test runs the real service logic with an in-memory store: no database, fast and repeatable",
          "explanation": "Right. Depending on an abstraction lets you swap the detail."
        },
        {
          "text": "FakeStore makes production faster",
          "explanation": "It's only used in tests."
        },
        {
