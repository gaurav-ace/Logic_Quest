  "steps": [
    {
      "caption": "Checkout works out the delivery fee with a branch for each pricing mode.",
      "diagram": "ifs",
      "highlight": [
        "checkout"
      ],
      "code": [
        "def fee(order, mode):",
        "    if mode == 'flat':",
        "        return 30",
        "    if mode == 'distance':",
        "        return 10 + 5 * order.km"
      ]
    },
    {
      "caption": "Strategy: each pricing rule becomes its own class behind a FeeRule interface, and Checkout holds one rule.",
      "diagram": "strategy",
      "highlight": [
        "rule",
        "flat",
        "distance"
      ]
    },
    {
      "caption": "Checkout just asks its rule. Which rule it holds can change while the app runs.",
      "diagram": "strategy",
      "highlight": [
        "checkout"
      ],
      "code": [
        "checkout = Checkout(DistanceFee())",
        "checkout.fee(order)"
      ],
      "predict": {
        "prompt": "It starts raining and the app switches Checkout to a SurgeFee rule. What changes in Checkout's code?",
        "options": [
          {
            "text": "Nothing: it's handed a different FeeRule",
            "explanation": "Right. Swapping the strategy object changes the behaviour, not the code."
          },
          {
            "text": "A new branch for rain",
            "explanation": "There are no branches left in Checkout."
          },
          {
            "text": "Checkout must inherit from SurgeFee",
            "explanation": "Checkout has a rule; it doesn't need to be one."
          }
        ],
        "answer": 0
      }
    },
    {
      "caption": "But who picks the rule? If every caller writes its own if city == …, the choice is copied everywhere. A factory owns that one decision.",
      "diagram": "factory",
      "highlight": [
        "factory"
      ],
      "code": [
        "def make(city):",
        "    if city in METROS:",
        "        return DistanceFee()",
        "    return FlatFee()"
      ]
    },
    {
      "caption": "Checkout asks the factory for Pune's rule…",
      "diagram": "run",
      "call": 0
    },
    {
      "caption": "…gets a DistanceFee back…",
      "diagram": "run",
      "call": 1
    },
    {
      "caption": "…and uses it like any other FeeRule.",
      "diagram": "run",
      "call": 3,
      "predict": {
        "prompt": "Pune moves to distance pricing next month. Where do you edit?",
        "options": [
          {
            "text": "make(), the one place that chooses",
            "explanation": "Right. Callers ask the factory, so the choice is in one place."
          },
          {
            "text": "Checkout and Quote",
            "explanation": "They don't choose any more; they ask the factory."
          },
          {
            "text": "DistanceFee",
            "explanation": "DistanceFee computes fees; it doesn't decide which cities use it."
          }
        ],
        "answer": 0
      }
    }
