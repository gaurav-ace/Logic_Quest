  "exercise": {
    "change": "Add festival pricing (₹20 off) for every city this week.",
    "flawed": "copies",
    "fixed": "central",
    "edits": {
      "flawed": [
        "checkout",
        "quote",
        "invoice"
      ],
      "fixed": [
        "factory"
      ]
    },
    "hint": "Each of these classes has its own copy of the \"which fee?\" if-chain.",
    "fix": {
      "prompt": "How should the design change?",
      "options": [
        {
          "text": "Put each fee rule behind a FeeRule interface, and pick the rule in one factory all three use",
          "explanation": "Right. A new rule is a new class plus one edit to the factory."
        },
        {
          "text": "Copy the festival branch into each if-chain",
          "explanation": "That's three edits now and three more next time, and the copies drift apart."
        },
        {
          "text": "Make Quote and Invoice inherit from Checkout to share its if-chain",
          "explanation": "A quote isn't a checkout; inheriting to share code ties unrelated classes together."
        }
      ],
      "answer": 0
    },
    "explain": "The fee rules are strategies, and FeeFactory is the one place that chooses between them. Festival pricing is a new FestivalFee class plus one edit to make(); Checkout, Quote and Invoice don't change."
  },
  "quiz": [
    {
      "prompt": "What does the Strategy pattern let you do?",
      "options": [
        {
          "text": "Swap one algorithm for another at run time, behind the same interface",
          "explanation": "Right. The caller holds \"a FeeRule\" and doesn't care which."
        },
        {
          "text": "Create objects without naming their class",
          "explanation": "That's closer to a factory."
        },
        {
          "text": "Tell many listeners about a change",
          "explanation": "That's Observer."
        }
      ],
      "answer": 0
    },
    {
      "prompt": "Why put object creation in a factory?",
      "options": [
        {
          "text": "The decision about which class to make lives in one place, so changing it is one edit",
          "explanation": "Right. Callers ask for \"the rule for Pune\" instead of deciding themselves."
        },
        {
          "text": "Factories create objects faster",
          "explanation": "Speed isn't the point."
        },
        {
          "text": "Python requires it",
          "explanation": "Python lets you call classes directly; a factory is a design choice."
        }
      ],
      "answer": 0
    }
  ]
